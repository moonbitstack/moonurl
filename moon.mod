name = "moonbitstack/moonurl"

version = "0.1.0"

readme = "README.md"

repository = "https://github.com/moonbitstack/moonurl"

license = "Apache-2.0"

keywords = [
  "url",
  "uri",
  "rfc3986",
  "percent-encoding",
  "data-url",
  "moonbit",
]

description = "URI references as RFC 3986 defines them: parsing, recomposing, resolving and percent coding by component, and data URLs. No sockets."

preferred_target = "wasm-gc"

import {
  "moonbitstack/moonmime@0.1.0",
  "moonbitstack/moonbase@0.4.0",
}
