name = "moonbitstack/moonurl"

version = "0.2.1"

readme = "README.md"

repository = "https://github.com/moonbitstack/moonurl"

license = "Apache-2.0"

keywords = [
  "url",
  "uri",
  "rfc3986",
  "whatwg",
  "idna",
  "punycode",
  "uri-template",
  "rfc6570",
  "percent-encoding",
  "data-url",
  "urlencoded",
  "moonbit",
]

description = "URLs for MoonBit: WHATWG and RFC 3986 parsing, IDNA, URI templates, percent coding."

import {
  "moonbitstack/moonmime@0.2.0",
  "moonbitstack/moonbase@0.4.0",
  "moonbitstack/moonucd@0.1.1",
}

source = "src"
