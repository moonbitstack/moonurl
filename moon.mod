name = "moonbitstack/moonurl"

version = "0.2.6"

readme = "README.md"

repository = "https://github.com/moonbitstack/moonurl"

license = "Apache-2.0"

keywords = [
  "url",
  "uri",
  "rfc3986",
  "whatwg",
  "idna",
  "punycode",
  "uts46",
  "uri-template",
  "rfc6570",
  "percent-encoding",
  "data-url",
  "urlencoded",
  "url-parser",
  "query-string",
  "moonbit",
]

description = "URLs for MoonBit: WHATWG and RFC 3986 parsing, IDNA, URI templates, percent coding."

import {
  "moonbitstack/moonmime@0.3.0",
  "moonbitstack/moonbase@0.5.0",
  "moonbitstack/moonucd@0.1.4",
}

source = "src"
