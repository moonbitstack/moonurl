name = "moonbitstack/moonurl"

version = "0.2.0"

readme = "README.md"

repository = "https://github.com/moonbitstack/moonurl"

license = "Apache-2.0"

keywords = [
  "url",
  "uri",
  "rfc3986",
  "percent-encoding",
  "data-url",
  "urlencoded",
  "moonbit",
]

description = "URI references for MoonBit, as RFC 3986 defines them."

import {
  "moonbitstack/moonmime@0.2.0",
  "moonbitstack/moonbase@0.4.0",
  "moonbitstack/moonucd@0.1.1",
}

source = "src"
