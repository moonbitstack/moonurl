///|
test "sorting from web-platform-tests" {
  let complaints : Array[String] = []
  for row in sort_cases {
    let source = row.0
    let want = row.1
    let query = @moonurl.Query::decode(@utf8.encode(source)[:])
    query.sort()
    let got = query.encode()
    let expected = @moonurl.Query::new(pairs=want).encode()
    note(complaints, got == expected, source, "sort", got, expected)
  }
  complain(complaints)
}
