///|
/// One row of urlsearchparams-sort.any.js: a body, and the pairs the
/// standard's sort leaves in it, in order.
let sort_cases : Array[(String, Array[(String, String)])] = [
  ("z=b&a=b&z=a&a=a", [("a", "b"), ("a", "a"), ("z", "b"), ("z", "a")]),
  (
    "\u{FFFD}=x&\u{FFFC}&\u{FFFD}=a",
    [("\u{FFFC}", ""), ("\u{FFFD}", "x"), ("\u{FFFD}", "a")],
  ),
  ("\u{FB03}&\u{1F308}", [("\u{1F308}", ""), ("\u{FB03}", "")]),
  (
    "\u{E9}&e\u{FFFD}&e\u{301}",
    [("e\u{301}", ""), ("e\u{FFFD}", ""), ("\u{E9}", "")],
  ),
  (
    "z=z&a=a&z=y&a=b&z=x&a=c&z=w&a=d&z=v&a=e&z=u&a=f&z=t&a=g",
    [
      ("a", "a"),
      ("a", "b"),
      ("a", "c"),
      ("a", "d"),
      ("a", "e"),
      ("a", "f"),
      ("a", "g"),
      ("z", "z"),
