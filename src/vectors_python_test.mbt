  ("http://[2001:db8::1]:8080/a", "http", "[2001:db8::1]:8080", "/a", "", ""),
  ("http://[::1]/p?q#f", "http", "[::1]", "/p", "q", "f"),
  (
    "https://example.test/a%2Fb?q=%20#frag", "https", "example.test", "/a%2Fb", "q=%20",
