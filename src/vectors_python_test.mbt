  ("Query", "aZ09-._~", "aZ09-._~"),
  ("Query", "a b", "a%20b"),
  ("Query", "a/b", "a/b"),
  ("Query", "a?b#c", "a?b%23c"),
  ("Query", "a&b=c", "a&b=c"),
  ("Query", "100%", "100%25"),
  ("Query", "%7e", "%257e"),
  ("Query", "r\u{E9}sum\u{E9}", "r%C3%A9sum%C3%A9"),
  ("Query", "\u{9A87}\u{5154} rides", "%E9%AA%87%E5%85%94%20rides"),
  ("Query", "a+b", "a+b"),
  ("Query", "!$&'()*+,;=:@", "!$&'()*+,;=:@"),
  ("Query", "", ""),
  ("Fragment", "aZ09-._~", "aZ09-._~"),
  ("Fragment", "a b", "a%20b"),
  ("Fragment", "a/b", "a/b"),
