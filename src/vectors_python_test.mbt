  ("a/b/c", "", "", "a/b/c", "", ""),
  ("", "", "", "", "", ""),
  ("?q", "", "", "", "q", ""),
  ("#f", "", "", "", "", "f"),
  ("mailto:leo@example.test", "mailto", "", "leo@example.test", "", ""),
  ("urn:isbn:0451450523", "urn", "", "isbn:0451450523", "", ""),
  ("file:///tmp/x", "file", "", "/tmp/x", "", ""),
  ("file://localhost/tmp/x", "file", "localhost", "/tmp/x", "", ""),
  ("foo://h/a/b", "foo", "h", "/a/b", "", ""),
  ("foo:/a/b", "foo", "", "/a/b", "", ""),
  ("http://example.test/a/../b", "http", "example.test", "/a/../b", "", ""),
