  ("Segment", "r\u{E9}sum\u{E9}", "r%C3%A9sum%C3%A9"),
  ("Segment", "\u{9A87}\u{5154} rides", "%E9%AA%87%E5%85%94%20rides"),
  ("Segment", "a+b", "a+b"),
  ("Segment", "!$&'()*+,;=:@", "!$&'()*+,;=:@"),
