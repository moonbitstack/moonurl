  ("Path", "aZ09-._~", "aZ09-._~"),
  ("Path", "a b", "a%20b"),
  ("Path", "a/b", "a/b"),
  ("Path", "a?b#c", "a%3Fb%23c"),
  ("Path", "a&b=c", "a&b=c"),
  ("Path", "100%", "100%25"),
  ("Path", "%7e", "%257e"),
  ("Path", "r\u{E9}sum\u{E9}", "r%C3%A9sum%C3%A9"),
  ("Path", "\u{9A87}\u{5154} rides", "%E9%AA%87%E5%85%94%20rides"),
  ("Path", "a+b", "a+b"),
  ("Path", "!$&'()*+,;=:@", "!$&'()*+,;=:@"),
