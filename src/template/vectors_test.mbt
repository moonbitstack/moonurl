    "keys",
    @template.Value::Pairs([("semi", ";"), ("dot", "."), ("comma", ",")]),
  )
  values.set("v", @template.Value::Text("6"))
  values.set("x", @template.Value::Text("1024"))
  values.set("y", @template.Value::Text("768"))
