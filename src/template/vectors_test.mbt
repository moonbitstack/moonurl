///|
test "uritemplate-test: extended-tests.json / Additional Examples 6: Reserved Expansion" {
  let values : Map[String, @template.Value] = Map([])
  values.set("id", @template.Value::Text("admin%2F"))
  values.set("not_pct", @template.Value::Text("%foo"))
