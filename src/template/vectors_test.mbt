        }
      Some(t) =>
        if refused {
          let failed = try {
            let _ = t.expand(values)
            false
          } catch {
            _ => true
          }
          if !failed {
            complaints.push("accepted a template it must refuse: " + template)
          }
        } else {
          let expanded = Some(t.expand(values)) catch { _ => None }
          match expanded {
            None =>
              complaints.push(
                "failed to expand a template it must read: " + template,
              )
            Some(got) =>
              if !wants.contains(got) {
                complaints.push("expansion of " + template + " gave " + got)
              }
          }
        }
    }
  }
  if !complaints.is_empty() {
    let out = StringBuilder()
    out.write_string("\{complaints.length()} case(s) differ:")
    for i, c in complaints {
      if i >= 20 {
        break
      }
      out.write_string("\n  " + c)
    }
    fail(out.to_string())
  }
}

