}

///|
test "uritemplate-test: extended-tests.json / Additional Examples 8: Literal Encoding" {
  let values : Map[String, @template.Value] = Map([])
  values.set("var", @template.Value::Text("value"))
  let cases : Array[(String, Array[String], Bool)] = [
    ("caf\u{E9}/{var}", ["caf%C3%A9/value"], false),
    ("x%20y/{var}", ["x%20y/value"], false),
    ("x%20y{var}z%20w", ["x%20yvaluez%20w"], false),
  ]
  let complaints : Array[String] = []
  for (template, wants, refused) in cases {
    let decoded = Some(@template.Template::decode(template[:])) catch {
      _ => None
    }
    match decoded {
      None =>
        if !refused {
          complaints.push("refused a template it must read: " + template)
        }
      Some(t) =>
        if refused {
          let failed = try {
            let _ = t.expand(values)
            false
          } catch {
            _ => true
          }
          if !failed {
            complaints.push("accepted a template it must refuse: " + template)
          }
        } else {
          let expanded = Some(t.expand(values)) catch { _ => None }
          match expanded {
            None =>
              complaints.push(
                "failed to expand a template it must read: " + template,
              )
            Some(got) =>
              if !wants.contains(got) {
                complaints.push("expansion of " + template + " gave " + got)
              }
          }
        }
    }
  }
  if !complaints.is_empty() {
    let out = StringBuilder()
    out.write_string("\{complaints.length()} case(s) differ:")
    for i, c in complaints {
      if i >= 20 {
        break
      }
      out.write_string("\n  " + c)
    }
    fail(out.to_string())
  }
}

///|
test "uritemplate-test: negative-tests.json / Failure Tests" {
  let values : Map[String, @template.Value] = Map([])
  values.set("id", @template.Value::Text("thing"))
  values.set("var", @template.Value::Text("value"))
  values.set("hello", @template.Value::Text("Hello World!"))
  values.set("with space", @template.Value::Text("fail"))
  values.set(" leading_space", @template.Value::Text("Hi!"))
  values.set("trailing_space ", @template.Value::Text("Bye!"))
  values.set("empty", @template.Value::Text(""))
  values.set("path", @template.Value::Text("/foo/bar"))
  values.set("x", @template.Value::Text("1024"))
  values.set("y", @template.Value::Text("768"))
  values.set("list", @template.Value::List(["red", "green", "blue"]))
  values.set(
    "keys",
    @template.Value::Pairs([("semi", ";"), ("dot", "."), ("comma", ",")]),
  )
  values.set("example", @template.Value::Text("red"))
  values.set("searchTerms", @template.Value::Text("uri templates"))
  values.set("~thing", @template.Value::Text("some-user"))
  values.set(
    "default-graph-uri",
    @template.Value::List([
      "http://www.example/book/", "http://www.example/papers/",
    ]),
  )
  values.set(
    "query",
    @template.Value::Text(
      "PREFIX dc: <http://purl.org/dc/elements/1.1/> SELECT ?book ?who WHERE { ?book dc:creator ?who }",
    ),
  )
  let cases : Array[(String, Array[String], Bool)] = [
    ("{/id*", [], true),
    ("/id*}", [], true),
    ("{/?id}", [], true),
    ("{var:prefix}", [], true),
    ("{hello:2*}", [], true),
    ("{??hello}", [], true),
    ("{!hello}", [], true),
    ("{with space}", [], true),
    ("{ leading_space}", [], true),
    ("{trailing_space }", [], true),
    ("{=path}", [], true),
    ("{$var}", [], true),
    ("{|var*}", [], true),
    ("{*keys?}", [], true),
    ("{?empty=default,var}", [], true),
    ("{var}{-prefix|/-/|var}", [], true),
    ("?q={searchTerms}&amp;c={example:color?}", [], true),
    ("x{?empty|foo=none}", [], true),
    ("/h{#hello+}", [], true),
    ("/h#{hello+}", [], true),
    ("{keys:1}", [], true),
    ("{+keys:1}", [], true),
    ("{;keys:1*}", [], true),
    ("?{-join|&|var,list}", [], true),
    ("/people/{~thing}", [], true),
    ("/{default-graph-uri}", [], true),
    ("/sparql{?query,default-graph-uri}", [], true),
    ("/sparql{?query){&default-graph-uri*}", [], true),
    ("/resolution{?x, y}", [], true),
    ("{var:0}", [], true),
    ("{var:01}", [], true),
    ("{var:10000}", [], true),
    ("{var:}", [], true),
    ("{x.}", [], true),
    ("{x..y}", [], true),
    ("{%2x}", [], true),
  ]
  let complaints : Array[String] = []
  for (template, wants, refused) in cases {
    let decoded = Some(@template.Template::decode(template[:])) catch {
      _ => None
    }
    match decoded {
      None =>
        if !refused {
          complaints.push("refused a template it must read: " + template)
        }
      Some(t) =>
        if refused {
          let failed = try {
            let _ = t.expand(values)
            false
          } catch {
            _ => true
          }
          if !failed {
            complaints.push("accepted a template it must refuse: " + template)
          }
        } else {
          let expanded = Some(t.expand(values)) catch { _ => None }
          match expanded {
            None =>
              complaints.push(
                "failed to expand a template it must read: " + template,
              )
            Some(got) =>
              if !wants.contains(got) {
                complaints.push("expansion of " + template + " gave " + got)
              }
          }
        }
    }
  }
  if !complaints.is_empty() {
    let out = StringBuilder()
    out.write_string("\{complaints.length()} case(s) differ:")
    for i, c in complaints {
      if i >= 20 {
        break
      }
      out.write_string("\n  " + c)
    }
    fail(out.to_string())
  }
}
