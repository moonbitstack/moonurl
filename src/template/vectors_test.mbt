test "uritemplate-test: spec-examples-by-section.json / 3.2.3 Reserved Expansion" {
  let values : Map[String, @template.Value] = Map([])
  values.set("count", @template.Value::List(["one", "two", "three"]))
  values.set("dom", @template.Value::List(["example", "com"]))
  values.set("dub", @template.Value::Text("me/too"))
  values.set("hello", @template.Value::Text("Hello World!"))
  values.set("half", @template.Value::Text("50%"))
  values.set("var", @template.Value::Text("value"))
  values.set("who", @template.Value::Text("fred"))
  values.set("base", @template.Value::Text("http://example.com/home/"))
  values.set("path", @template.Value::Text("/foo/bar"))
  values.set("list", @template.Value::List(["red", "green", "blue"]))
  values.set(
    "keys",
    @template.Value::Pairs([("semi", ";"), ("dot", "."), ("comma", ",")]),
  )
  values.set("v", @template.Value::Text("6"))
  values.set("x", @template.Value::Text("1024"))
  values.set("y", @template.Value::Text("768"))
  values.set("empty", @template.Value::Text(""))
  values.set("empty_keys", @template.Value::Pairs([]))
  let cases : Array[(String, Array[String], Bool)] = [
    ("{+var}", ["value"], false),
    ("{/var,empty}", ["/value/"], false),
    ("{/var,undef}", ["/value"], false),
    ("{+hello}", ["Hello%20World!"], false),
    ("{+half}", ["50%25"], false),
    ("{base}index", ["http%3A%2F%2Fexample.com%2Fhome%2Findex"], false),
    ("{+base}index", ["http://example.com/home/index"], false),
    ("O{+empty}X", ["OX"], false),
    ("O{+undef}X", ["OX"], false),
    ("{+path}/here", ["/foo/bar/here"], false),
    ("{+path:6}/here", ["/foo/b/here"], false),
    ("here?ref={+path}", ["here?ref=/foo/bar"], false),
    ("up{+path}{var}/here", ["up/foo/barvalue/here"], false),
    ("{+x,hello,y}", ["1024,Hello%20World!,768"], false),
    ("{+path,x}/here", ["/foo/bar,1024/here"], false),
    ("{+list}", ["red,green,blue"], false),
    ("{+list*}", ["red,green,blue"], false),
    (
      "{+keys}",
      [
        "comma,,,dot,.,semi,;", "comma,,,semi,;,dot,.", "dot,.,comma,,,semi,;", "dot,.,semi,;,comma,,",
        "semi,;,comma,,,dot,.", "semi,;,dot,.,comma,,",
      ],
      false,
    ),
    (
      "{+keys*}",
      [
        "comma=,,dot=.,semi=;", "comma=,,semi=;,dot=.", "dot=.,comma=,,semi=;", "dot=.,semi=;,comma=,",
        "semi=;,comma=,,dot=.", "semi=;,dot=.,comma=,",
      ],
      false,
    ),
  ]
  let complaints : Array[String] = []
  for (template, wants, refused) in cases {
    let decoded = Some(@template.Template::decode(template[:])) catch {
      _ => None
    }
    match decoded {
      None =>
        if !refused {
          complaints.push("refused a template it must read: " + template)
        }
      Some(t) =>
        if refused {
          let failed = try {
            let _ = t.expand(values)
            false
          } catch {
            _ => true
          }
          if !failed {
            complaints.push("accepted a template it must refuse: " + template)
          }
        } else {
          let expanded = Some(t.expand(values)) catch { _ => None }
          match expanded {
            None =>
              complaints.push(
                "failed to expand a template it must read: " + template,
              )
            Some(got) =>
              if !wants.contains(got) {
                complaints.push("expansion of " + template + " gave " + got)
              }
          }
        }
    }
  }
  if !complaints.is_empty() {
    let out = StringBuilder()
    out.write_string("\{complaints.length()} case(s) differ:")
    for i, c in complaints {
      if i >= 20 {
        break
      }
      out.write_string("\n  " + c)
    }
    fail(out.to_string())
  }
}

