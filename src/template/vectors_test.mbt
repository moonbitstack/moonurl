  values.set(
    "keys",
    @template.Value::Pairs([("key1", "val1%2F"), ("key2", "val2%2F")]),
  )
  let cases : Array[(String, Array[String], Bool)] = [
    ("{+id}", ["admin%2F"], false),
    ("{#id}", ["#admin%2F"], false),
    ("{id}", ["admin%252F"], false),
    ("{+not_pct}", ["%25foo"], false),
    ("{#not_pct}", ["#%25foo"], false),
    ("{not_pct}", ["%25foo"], false),
    ("{+list}", ["red%25,%2Fgreen,blue%20"], false),
