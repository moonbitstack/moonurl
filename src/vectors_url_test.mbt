///|
test "URL parsing from web-platform-tests" {
  let complaints : Array[String] = []
  for case in url_cases {
    let base = if case.base == "" {
      None
    } else {
      Some(@moonurl.Url::decode(case.base[:], syntax=@moonurl.Whatwg)) catch {
        _ => None
      }
    }
    let parsed = Some(
      @moonurl.Url::decode(case.input[:], syntax=@moonurl.Whatwg, base?),
    ) catch {
      _ => None
    }
    match parsed {
      None =>
        note_flag(complaints, case.failure, case.input, "refusal", case.base)
      Some(url) => {
        note_flag(
          complaints,
          !case.failure,
          case.input,
          "acceptance",
          case.base,
        )
        note(
          complaints,
          url.encode() == case.href,
          case.input,
          "href",
          url.encode(),
          case.href,
        )
        let fields = fields_of(url)
        let want = [
          case.protocol,
          case.username,
          case.password,
          case.host,
          case.hostname,
          case.port,
          case.pathname,
          case.search,
          case.hash,
          case.origin,
        ]
        let names = [
          "protocol", "username", "password", "host", "hostname", "port", "pathname",
          "search", "hash", "origin",
        ]
        for i, name in names {
          if want[i] != unchecked {
            note(
              complaints,
              fields[i] == want[i],
              case.input,
              name,
              fields[i],
              want[i],
            )
          }
        }
      }
    }
  }
  complain(complaints)
}

///|
/// One row of setters_tests.json: which member is set, to what, on
/// which URL, and what every getter should say afterwards. A getter
/// the row does not mention is `\u{1}`.
struct Setting {
  which : String
  href : String
  value : String
}

///|
let setter_cases : Array[(Setting, Array[String])] = [
  (
    { which: "protocol", href: "a://example.net", value: "", },
    [
      "a:", "\u{1}", "\u{1}", "\u{1}", "\u{1}", "\u{1}", "\u{1}", "\u{1}", "\u{1}",
      "a://example.net",
    ],
  ),
  (
    { which: "protocol", href: "a://example.net", value: "b", },
    [
      "b:", "\u{1}", "\u{1}", "\u{1}", "\u{1}", "\u{1}", "\u{1}", "\u{1}", "\u{1}",
      "b://example.net",
    ],
  ),
  (
    { which: "protocol", href: "javascript:alert(1)", value: "defuse", },
    [
      "defuse:", "\u{1}", "\u{1}", "\u{1}", "\u{1}", "\u{1}", "\u{1}", "\u{1}", "\u{1}",
      "defuse:alert(1)",
    ],
  ),
  (
    { which: "protocol", href: "a://example.net", value: "B", },
    [
      "b:", "\u{1}", "\u{1}", "\u{1}", "\u{1}", "\u{1}", "\u{1}", "\u{1}", "\u{1}",
      "b://example.net",
    ],
  ),
  (
    { which: "protocol", href: "a://example.net", value: "\u{E9}", },
    [
      "a:", "\u{1}", "\u{1}", "\u{1}", "\u{1}", "\u{1}", "\u{1}", "\u{1}", "\u{1}",
      "a://example.net",
    ],
  ),
  (
    { which: "protocol", href: "a://example.net", value: "0b", },
    [
      "a:", "\u{1}", "\u{1}", "\u{1}", "\u{1}", "\u{1}", "\u{1}", "\u{1}", "\u{1}",
      "a://example.net",
    ],
  ),
  (
    { which: "protocol", href: "a://example.net", value: "+b", },
    [
      "a:", "\u{1}", "\u{1}", "\u{1}", "\u{1}", "\u{1}", "\u{1}", "\u{1}", "\u{1}",
      "a://example.net",
    ],
  ),
  (
