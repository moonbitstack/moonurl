///|
test "URL setters from web-platform-tests" {
  let complaints : Array[String] = []
  let names = [
    "protocol", "username", "password", "host", "hostname", "port", "pathname", "search",
    "hash", "href",
  ]
  for (setting, want) in setter_cases {
    let url = @moonurl.Url::decode(setting.href[:], syntax=@moonurl.Whatwg)
    let value = setting.value[:]
    let got = match setting.which {
      "protocol" => url.set_scheme(value)
      "username" => url.set_username(value)
      "password" => url.set_password(value)
      "host" => url.set_host(value)
      "hostname" => url.set_hostname(value)
      "port" => url.set_port(value)
      "pathname" => url.set_path(value)
      "search" => url.set_query(value)
      "hash" => url.set_fragment(value)
      "href" => @moonurl.Url::decode(value, syntax=@moonurl.Whatwg)
      _ => url
    }
    let fields = fields_of(got)
    for i, name in names {
      if want[i] != unchecked {
        let got = if i == 9 { got.encode() } else { fields[i] }
        note(complaints, got == want[i], setting.href, name, got, want[i])
      }
    }
  }
  complain(complaints)
}
