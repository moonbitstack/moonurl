///|
/// A form body before and after a sort, as Node's `URLSearchParams`
/// writes it.
let node_queries : Array[(String, String, String)] = [
  ("a=1&b=2&a=3", "a=1&b=2&a=3", "a=1&a=3&b=2"),
  ("b=2&a=1&b=3", "b=2&a=1&b=3", "a=1&b=2&b=3"),
  ("a", "a=", "a="),
  ("a=", "a=", "a="),
  ("=b", "=b", "=b"),
  ("&", "", ""),
  ("&&&a=b&&&&c=d&", "a=b&c=d", "a=b&c=d"),
  ("a=a+b+c+d", "a=a+b+c+d", "a=a+b+c+d"),
  ("a=%26b%3Dc", "a=%26b%3Dc", "a=%26b%3Dc"),
  ("a=%E9%AA%87", "a=%E9%AA%87", "a=%E9%AA%87"),
  ("a=*%2D._", "a=*-._", "a=*-._"),
  ("a=%7E", "a=%7E", "a=%7E"),
  ("a=b%2Bc&a%2Bb=c", "a=b%2Bc&a%2Bb=c", "a=b%2Bc&a%2Bb=c"),
  ("a==a", "a=%3Da", "a=%3Da"),
  ("%=a", "%25=a", "%25=a"),
  ("b=%%2a", "b=%25*", "b=%25*"),
  ("id=0&value=%", "id=0&value=%25", "id=0&value=%25"),
  ("a=b&c=d&&e&&", "a=b&c=d&e=", "a=b&c=d&e="),
  ("a = b &a=b&c=d%20", "a+=+b+&a=b&c=d+", "a=b&a+=+b+&c=d+"),
  ("a=%00", "a=%00", "a=%00"),
  ("A=1&a=2", "A=1&a=2", "A=1&a=2"),
  ("\u{2000B}C=1", "%F0%A0%80%8BC=1", "%F0%A0%80%8BC=1"),
  ("a=1&a=2&a=3&a=4", "a=1&a=2&a=3&a=4", "a=1&a=2&a=3&a=4"),
  ("", "", ""),
]

///|
/// A host name and what `url.domainToASCII` makes of it. An empty
/// answer is a name Node refuses.
let node_hosts : Array[(String, String)] = [
  ("example.test", "example.test"),
  ("EXAMPLE.TEST", "example.test"),
  ("example.test.", "example.test."),
  ("m\u{FC}nchen.example", "xn--mnchen-3ya.example"),
  ("M\u{DC}NCHEN.example", "xn--mnchen-3ya.example"),
  ("xn--mnchen-3ya.example", "xn--mnchen-3ya.example"),
  ("\u{4F8B}\u{3048}.\u{30C6}\u{30B9}\u{30C8}", "xn--r8jz45g.xn--zckzah"),
  ("fa\u{DF}.de", "xn--fa-hia.de"),
  ("Fa\u{DF}.de", "xn--fa-hia.de"),
  ("\u{3B2}\u{3CC}\u{3BB}\u{3BF}\u{3C2}.example", "xn--nxasmm1c.example"),
  ("a\u{200C}b.example", ""),
  ("a\u{200D}b.example", ""),
  ("-x.example", "-x.example"),
  ("x-.example", "x-.example"),
  ("ab--c.example", "ab--c.example"),
  ("exa mple.test", ""),
  ("a..b", "a..b"),
  (".a", ".a"),
  ("a..", "a.."),
  (
    "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.example", "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.example",
  ),
  (
    "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
  ),
  ("127.0.0.1", "127.0.0.1"),
  ("0x7f.1", "127.0.0.1"),
  ("2130706433", "127.0.0.1"),
  ("exa%41mple.test", "exaample.test"),
  ("\u{DC}n\u{EF}c\u{F6}d\u{E9}.example", "xn--ncd-dma1a7bzb.example"),
  ("\u{65E5}\u{672C}\u{8A9E}.jp", "xn--wgv71a119e.jp"),
  ("\u{D6}BB.at", "xn--bb-eka.at"),
  ("a_b.example", "a_b.example"),
  ("a*b.example", "a*b.example"),
  ("a\u{AD}b.example", "ab.example"),
  ("a\u{200D}b\u{200D}c.example", ""),
]

///|
/// The corpus, read the way a browser reads it: every getter and the
/// serialisation against a second implementation of the same standard.
test "URL parsing, against Node" {
  let complaints : Array[String] = []
  for case in node_cases {
    let base = if case.base == "" {
      None
    } else {
      Some(@moonurl.Url::decode(case.base[:], syntax=@moonurl.Whatwg)) catch {
        _ => None
      }
    }
    let parsed = Some(
      @moonurl.Url::decode(case.input[:], syntax=@moonurl.Whatwg, base?),
    ) catch {
      _ => None
    }
    match parsed {
      None => complaints.push("\{case.input}: refused, Node reads it")
      Some(url) => {
        let label = if case.base == "" {
          case.input
        } else {
          "\{case.input} against \{case.base}"
        }
        note(
          complaints,
          url.encode() == case.href,
          label,
          "href",
          url.encode(),
          case.href,
        )
        // Node writes bytes that are a URL again, and our reader has to see the
        // same URL in them: the second half of a round trip between the two.
        let reread = Some(
          @moonurl.Url::decode(case.href[:], syntax=@moonurl.Whatwg),
        ) catch {
          _ => None
        }
        match reread {
          None =>
            complaints.push("\{label}: our bytes \{case.href} do not read back")
          Some(again) =>
            note(
              complaints,
              again.encode() == case.href,
              label,
              "re-reading",
              again.encode(),
              case.href,
            )
        }
        let fields = fields_of(url)
        let want = [
          case.protocol,
          case.username,
          case.password,
          case.host,
          case.hostname,
          case.port,
          case.pathname,
          case.search,
          case.hash,
          case.origin,
        ]
        let names = [
          "protocol", "username", "password", "host", "hostname", "port", "pathname",
          "search", "hash", "origin",
        ]
        for i, name in names {
          note(
            complaints,
            fields[i] == want[i],
            label,
            name,
            fields[i],
            want[i],
          )
        }
      }
    }
  }
  complain(complaints)
}

///|
/// The nine setters, on values that change the URL and on values that must not.
test "URL setters, against Node" {
  let complaints : Array[String] = []
  for setting in node_settings {
    let url = @moonurl.Url::decode(setting.base[:], syntax=@moonurl.Whatwg)
    let after = match setting.which {
      "protocol" => url.set_scheme(setting.value[:])
      "username" => url.set_username(setting.value[:])
      "password" => url.set_password(setting.value[:])
      "host" => url.set_host(setting.value[:])
      "hostname" => url.set_hostname(setting.value[:])
      "port" => url.set_port(setting.value[:])
      "pathname" => url.set_path(setting.value[:])
      "search" => url.set_query(setting.value[:])
      "hash" => url.set_fragment(setting.value[:])
      other => fail("no setter named \{other}")
    }
    note(
      complaints,
      after.encode() == setting.href,
      "\{setting.which} = \{setting.value} on \{setting.base}",
      "href",
      after.encode(),
      setting.href,
    )
  }
  complain(complaints)
}

///|
/// A form body read and written by Node's `URLSearchParams`, before and after
/// its `sort`.
test "form bodies, against Node" {
  let complaints : Array[String] = []
  for row in node_queries {
    let (raw, written, sorted) = row
    let query = @moonurl.Query::decode(@utf8.encode(raw)[:])
    note(
      complaints,
      query.encode() == written,
      raw,
      "encode",
      query.encode(),
      written,
    )
    query.sort()
    note(
      complaints,
      query.encode() == sorted,
      raw,
      "sort",
      query.encode(),
      sorted,
    )
  }
  complain(complaints)
}

///|
/// Hosts, through the parser a browser uses: UTS 46, the numeric spellings of
/// IPv4, escapes and the brackets of IPv6, against Node's answers.
test "hosts, against Node" {
  let complaints : Array[String] = []
  for row in node_hosts {
    let (name, want) = row
    let text = "http://" + name + "/"
    let got = Some(@moonurl.Url::decode(text[:], syntax=@moonurl.Whatwg)) catch {
      _ => None
    }
    match got {
      None =>
        if want != "" {
          complaints.push("\{name}: refused, Node reads \{want}")
        }
      Some(url) =>
        if want == "" {
          let read = url.host.unwrap_or("")
          complaints.push("\{name}: read as \{read}, Node refuses it")
        } else {
          note(
            complaints,
            url.host == Some(want),
            name,
            "host",
            url.host.unwrap_or(""),
            want,
          )
        }
    }
  }
  complain(complaints)
}
