///|
test "UTS 46 conformance: IdnaTestV2" {
  let strict = @idna.strict
  let transitional = { ..strict, transitional: true, }
  let complaints : Array[String] = []
  let batches : Array[Array[(String, String, Bool, String, Bool, String, Bool)]] = [
    uts46_0, uts46_1, uts46_2, uts46_3, uts46_4, uts46_5, uts46_6, uts46_7,
  ]
  for batch in batches {
    for (source, unicode, ubad, ascii_n, nbad, ascii_t, tbad) in batch {
      let name = source[:]
      let u = @idna.to_unicode(name, options=strict)
      note(complaints, u.name == unicode, source, "toUnicode", u.name, unicode)
      note_flag(
        complaints,
        !u.errors.is_empty() == ubad,
        source,
        "toUnicode status",
      )
      let n = @idna.to_ascii(name, options=strict)
      note(complaints, n.name == ascii_n, source, "toASCII", n.name, ascii_n)
      note_flag(
        complaints,
        !n.errors.is_empty() == nbad,
        source,
        "toASCII status",
      )
      let t = @idna.to_ascii(name, options=transitional)
      note(
        complaints,
        t.name == ascii_t,
        source,
        "toASCII transitional",
        t.name,
        ascii_t,
      )
      note_flag(
        complaints,
        !t.errors.is_empty() == tbad,
        source,
        "toASCII transitional status",
      )
    }
  }
  complain(complaints)
}
